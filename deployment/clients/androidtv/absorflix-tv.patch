@@ -0,0 +1,95 @@
+package org.jellyfin.androidtv.branding
+
+import android.content.Intent
+import android.os.Build
+import android.provider.Settings
+import androidx.core.content.FileProvider
+import androidx.core.net.toUri
+import androidx.lifecycle.lifecycleScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+import org.jellyfin.androidtv.BuildConfig
+import org.jellyfin.androidtv.R
+import org.jellyfin.androidtv.ui.preference.dsl.OptionsFragment
+import org.jellyfin.androidtv.ui.preference.dsl.action
+import org.jellyfin.androidtv.ui.preference.dsl.optionsScreen
+import java.io.File
+
+class AbsorflixUpdateScreen : OptionsFragment() {
+	private var update: AbsorflixUpdate? = null
+	private var downloaded: File? = null
+	private var job: Job? = null
+	private var message: String? = null
+	private var busy = false
+
+	override val screen by optionsScreen {
+		setTitle(R.string.absorflix_updates_title)
+		category {
+			action {
+				setTitle(R.string.absorflix_updates_check)
+				content = message ?: BuildConfig.VERSION_NAME
+				enabled = !busy
+				onActivate = { checkUpdate() }
+			}
+			if (update != null) action {
+				setTitle(R.string.absorflix_updates_install)
+				content = update?.versionName
+				enabled = !busy
+				onActivate = { installUpdate() }
+			}
+		}
+	}
+
+	private fun checkUpdate() {
+		busy = true
+		message = getString(R.string.absorflix_updates_checking)
+		rebuild()
+		job = viewLifecycleOwner.lifecycleScope.launch {
+			try {
+				update = AbsorflixUpdates.check().takeIf { it.versionCode > BuildConfig.VERSION_CODE }
+				downloaded = null
+				message = update?.let { getString(R.string.absorflix_updates_available, it.versionName) }
+					?: getString(R.string.absorflix_updates_current)
+			} catch (error: CancellationException) { throw error
+			} catch (_: Exception) {
+				update = null
+				message = getString(R.string.absorflix_updates_failed)
+			} finally { busy = false; if (view != null) rebuild() }
+		}
+	}
+
+	private fun installUpdate() {
+		val context = requireContext()
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && !context.packageManager.canRequestPackageInstalls()) {
+			message = getString(R.string.absorflix_updates_permission)
+			rebuild()
+			startActivity(Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, "package:${context.packageName}".toUri()))
+			return
+		}
+		val release = update ?: return
+		busy = true
+		message = getString(R.string.absorflix_updates_download)
+		rebuild()
+		job = viewLifecycleOwner.lifecycleScope.launch {
+			try {
+				val apk = downloaded?.takeIf { it.isFile } ?: AbsorflixUpdates.download(context, release).also { downloaded = it }
+				val uri = FileProvider.getUriForFile(context, "${context.packageName}.updates", apk)
+				startActivity(Intent(Intent.ACTION_VIEW).apply {
+					setDataAndType(uri, "application/vnd.android.package-archive")
+					addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+				})
+				message = getString(R.string.absorflix_updates_available, release.versionName)
+			} catch (error: CancellationException) { throw error
+			} catch (_: Exception) {
+				downloaded = null
+				message = getString(R.string.absorflix_updates_invalid)
+			} finally { busy = false; if (view != null) rebuild() }
+		}
+	}
+
+	override fun onDestroyView() {
+		job?.cancel()
+		super.onDestroyView()
+	}
+}
diff --git a/app/src/main/java/org/jellyfin/androidtv/branding/BrandIntro.kt b/app/src/main/java/org/jellyfin/androidtv/branding/BrandIntro.kt
