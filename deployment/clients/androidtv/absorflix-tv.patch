+package org.jellyfin.androidtv.branding
+
+import android.os.Bundle
+import timber.log.Timber
+import android.view.Gravity
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.fragment.app.FragmentActivity
+
+/** Debug-only visual/lifecycle harness. Never included in the release APK. */
+class BrandIntroPreviewActivity : FragmentActivity() {
+	private var intro: BrandIntro? = null
+	override fun onCreate(savedInstanceState: Bundle?) {
+		super.onCreate(savedInstanceState)
+		val status = TextView(this).apply { text = "Absorflix · prueba de intro"; textSize = 24f; setTextColor(-1) }
+		val layout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; gravity = Gravity.CENTER; setBackgroundColor(0xFF080C14.toInt()) }
+		layout.addView(status)
+		val button = Button(this).apply { text = "Reproducir intro"; setOnClickListener {
+			intro?.cancel()
+			intro = BrandIntro(this@BrandIntroPreviewActivity, this@BrandIntroPreviewActivity, {
+				status.text = "Intro completada → listo para reproducir"; Timber.tag("AbsorflixIntroTest").i("COMPLETE"); intro = null
+			}, { status.text = "Cancelado · no se reproduce contenido"; Timber.tag("AbsorflixIntroTest").i("CANCEL"); intro = null })
+			intro?.start()
+		} }
+		layout.addView(button)
+		setContentView(layout)
+		button.requestFocus()
+	}
+}
diff --git a/app/src/main/java/org/jellyfin/androidtv/branding/AbsorflixUpdate.kt b/app/src/main/java/org/jellyfin/androidtv/branding/AbsorflixUpdate.kt
new file mode 100644
index 0000000..1d8038b
--- /dev/null
+++ b/app/src/main/java/org/jellyfin/androidtv/branding/AbsorflixUpdate.kt
@@ -0,0 +1,114 @@
+package org.jellyfin.androidtv.branding
+
+import android.content.Context
+import android.content.pm.PackageManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import org.jellyfin.androidtv.BuildConfig
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URI
+import java.security.MessageDigest
+import kotlin.coroutines.coroutineContext
+
+@Serializable
+data class AbsorflixUpdate(val versionCode: Int, val versionName: String, val url: String, val sha256: String, val size: Long) {
+	fun validate() {
+		require(versionCode > 0 && versionName.length in 1..80)
+		require(sha256.matches(Regex("[a-fA-F0-9]{64}")))
+		require(size in 1..MAX_APK_BYTES)
+		val uri = URI(url)
+		require(uri.scheme == "https" && uri.host == "player.absor.top")
+		require(uri.port == -1 || uri.port == 443)
+		require(uri.userInfo == null && uri.query == null && uri.fragment == null)
+		require(uri.normalize().path == uri.path && uri.rawPath == uri.path)
+		require(uri.path.startsWith("/web/absorflix/tv/") && uri.path.endsWith(".apk"))
+	}
+
+	companion object {
+		const val MANIFEST_URL = "https://player.absor.top/web/absorflix/tv/latest.json"
+		const val MAX_APK_BYTES = 150L * 1024 * 1024
+	}
+}
+
+object AbsorflixUpdates {
+	private fun connect(url: String) = (URI(url).toURL().openConnection() as HttpURLConnection).apply {
+		connectTimeout = 15000
+		readTimeout = 20000
+		instanceFollowRedirects = false
+		useCaches = false
+		setRequestProperty("Cache-Control", "no-cache")
+		setRequestProperty("Accept-Encoding", "identity")
+	}
+
+	suspend fun check(): AbsorflixUpdate = withContext(Dispatchers.IO) {
+		val connection = connect(AbsorflixUpdate.MANIFEST_URL)
+		try {
+			check(connection.responseCode == 200)
+			val bytes = connection.inputStream.use { input ->
+				val output = java.io.ByteArrayOutputStream()
+				val buffer = ByteArray(1024)
+				while (true) {
+					val count = input.read(buffer)
+					if (count == -1) break
+					require(output.size() + count <= 8192)
+					output.write(buffer, 0, count)
+				}
+				output.toByteArray()
+			}
+			require(bytes.size <= 8192)
+			Json { ignoreUnknownKeys = true }.decodeFromString<AbsorflixUpdate>(bytes.decodeToString()).also { it.validate() }
+		} finally { connection.disconnect() }
+	}
+
+	suspend fun download(context: Context, update: AbsorflixUpdate): File = withContext(Dispatchers.IO) {
+		update.validate()
+		require(update.versionCode > BuildConfig.VERSION_CODE)
+		val folder = File(context.cacheDir, "updates").apply { mkdirs() }
+		val partial = File(folder, "update.part")
+		val apk = File(folder, "absorflix-tv.apk")
+		val connection = connect(update.url)
+		try {
+			check(connection.responseCode == 200)
+			val digest = MessageDigest.getInstance("SHA-256")
+			var size = 0L
+			connection.inputStream.use { input ->
+				partial.outputStream().use { output ->
+					val buffer = ByteArray(65536)
+					while (true) {
+						coroutineContext.ensureActive()
+						val count = input.read(buffer)
+						if (count == -1) break
+						size += count
+						require(size <= update.size)
+						digest.update(buffer, 0, count)
+						output.write(buffer, 0, count)
+					}
+				}
+			}
+			require(size == update.size)
+			require(digest.digest().joinToString("") { "%02x".format(it) }.equals(update.sha256, ignoreCase = true))
+			verifyPackage(context, partial, update)
+			apk.delete()
+			check(partial.renameTo(apk))
+			apk
+		} finally {
+			connection.disconnect()
+			partial.delete()
+		}
+	}
+
+	@Suppress("DEPRECATION")
+	private fun verifyPackage(context: Context, apk: File, update: AbsorflixUpdate) {
+		val pm = context.packageManager
+		val candidate = requireNotNull(pm.getPackageArchiveInfo(apk.path, PackageManager.GET_SIGNATURES))
+		val installed = pm.getPackageInfo(context.packageName, PackageManager.GET_SIGNATURES)
+		require(candidate.packageName == context.packageName)
+		require(candidate.versionCode == update.versionCode && candidate.versionCode > installed.versionCode)
+		val signatures = candidate.signatures?.toSet().orEmpty()
+		require(signatures.isNotEmpty() && signatures == installed.signatures?.toSet())
+	}
+}
diff --git a/app/src/main/java/org/jellyfin/androidtv/branding/AbsorflixUpdateScreen.kt b/app/src/main/java/org/jellyfin/androidtv/branding/AbsorflixUpdateScreen.kt
