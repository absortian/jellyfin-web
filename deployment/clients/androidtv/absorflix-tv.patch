+<!doctype html>
+<html lang="es">
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Absorflix para TV</title>
+<style>
+:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#080c14;color:#eef5ff}body{max-width:820px;margin:auto;padding:64px 24px;line-height:1.65}img{width:min(340px,80%)}h1{font-size:clamp(32px,6vw,52px);line-height:1.1;margin-top:60px}p{color:#b6c6dc}a{color:#4fd8ff}a.button{display:inline-block;background:#00c9ff;color:#06101c;font-weight:700;padding:14px 25px;border-radius:12px;text-decoration:none;margin:12px 0 24px}li{margin:12px 0}section{background:#111b2b;padding:24px;border-radius:20px;margin:24px 0}small{color:#93a9c7}code{overflow-wrap:anywhere}footer{margin-top:48px;border-top:1px solid #27364b;padding-top:24px}
+</style>
+<img src="logo.svg" alt="Absorflix">
+<h1>Tu cine, también en la tele.</h1>
+<p>App Absorflix para Android TV, Google TV y Fire TV. Con el servidor ya configurado, vuestro logo y la intro antes de reproducir.</p>
+<a class="button" href="{{APK}}" download>Descargar Absorflix TV</a><br><small>Versión {{VERSION}} · Versión preliminar para probar en tu dispositivo</small>
+<section><h2>Instalar una vez</h2><ol><li>Abre esta dirección en Downloader o en un navegador de la TV:<br><code>https://player.absor.top/web/absorflix/tv/index.html</code></li><li>Descarga el APK. Si Android lo solicita, permite instalar aplicaciones desde esa herramienta y confirma la instalación.</li><li>Abre <strong>Absorflix</strong>. Conectará con <strong>player.absor.top</strong>.</li><li>Inicia sesión con tu cuenta o usa el código de Conexión rápida desde el móvil.</li></ol><p>Si tu TV no tiene navegador, puedes transferir el APK desde el móvil. Esta app se instala junto a Jellyfin; tus bibliotecas y cuentas siguen en el mismo servidor.</p></section>
+<section><h2>Las siguientes actualizaciones</h2><p>En Absorflix abre <strong>Ajustes → Acerca de → Actualizaciones de Absorflix</strong>. Pulsa «Buscar actualizaciones» y, cuando haya una disponible, «Instalar actualización». Android pedirá confirmar la instalación.</p></section>
+<p>Este APK es para dispositivos Android/Fire OS. Samsung Tizen, LG webOS y Apple TV necesitan su propia versión.</p>
+<footer><small>Basado en Jellyfin Android TV 0.19.10. <a href="{{SOURCE}}">Código fuente de esta versión</a> · <a href="LICENSE.txt">Licencia GPL-2.0</a> · <a href="https://player.absor.top">Abrir Absorflix web</a></small></footer>
+</html>
diff --git a/branding/generate_assets.py b/branding/generate_assets.py
new file mode 100644
index 0000000..1261e7e
--- /dev/null
+++ b/branding/generate_assets.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Export supplied Absorflix SVGs to Android resources. Requires rsvg-convert."""
+from pathlib import Path
+import re
+import subprocess
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+RES = ROOT / 'app/src/main/res'
+ASSETS = ROOT / 'branding/assets'
+SVG = '{http://www.w3.org/2000/svg}'
+ANDROID = 'http://schemas.android.com/apk/res/android'
+AAPT = 'http://schemas.android.com/aapt'
+ET.register_namespace('android', ANDROID)
+ET.register_namespace('aapt', AAPT)
+def attrs(**kw): return {f'{{{ANDROID}}}{k}': str(v) for k, v in kw.items()}
+def vector(width, height, vw, vh):
+    return ET.Element('vector', attrs(width=f'{width}dp', height=f'{height}dp', viewportWidth=vw, viewportHeight=vh))
+def save(name, root):
+    path = RES / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    ET.indent(root)
+    path.write_text(ET.tostring(root, encoding='unicode') + '\n')
+def gradient(path, x1, y1, x2, y2, start='#00C9FF', end='#0A84FF'):
+    attr = ET.SubElement(path, f'{{{AAPT}}}attr', {'name': 'android:fillColor'})
+    grad = ET.SubElement(attr, 'gradient', attrs(startX=x1, startY=y1, endX=x2, endY=y2, tileMode='clamp'))
+    ET.SubElement(grad, 'item', attrs(color=start, offset=0))
+    ET.SubElement(grad, 'item', attrs(color=end, offset=1))
+
+logo = ET.parse(ASSETS / 'logo.svg').getroot()
+v = vector(356, 60, 1296, 218.27)
+for src in logo.iter(SVG + 'path'):
+    p = ET.SubElement(v, 'path', attrs(pathData=' '.join(token if token.isalpha() else format(float(token), '.8f').rstrip('0').rstrip('.') for token in re.findall(r'[a-zA-Z]|[-+]?(?:[0-9]*\.[0-9]+|[0-9]+)', src.attrib['d']))))
+    cls = src.get('class')
+    if cls == 'cls-1': p.set(f'{{{ANDROID}}}fillColor', '#FFFFFF')
+    elif cls == 'cls-2': gradient(p, 40.63, 77.13, 184.43, 220.94, end='#0000FF')
+    elif cls == 'cls-3': gradient(p, 575.54, 75.17, 597.35, 96.99, end='#0000FF')
+    else: gradient(p, 867, 14.8, 1269.5, 201, end='#0000FF')
+save('drawable/app_logo.xml', v)
+save('drawable-v24/app_logo.xml', v)
+save('xml/absorflix_logo.xml', v)
+
+# Flatten the two supplied icon matrices, preserving the original paths.
+icon = ET.parse(ASSETS / 'icon.svg').getroot()
+paths = []
+for group in icon.findall(f'{SVG}g/{SVG}g'):
+    matrix = list(map(float, re.findall(r'-?\d+(?:\.\d+)?', group.attrib['transform'])))
+    a,b,c,d,e,f = matrix
+    src = group.find(SVG + 'path')
+    tokens = re.findall(r'[MCLZ]|-?(?:\d*\.)?\d+(?:[eE][-+]?\d+)?', src.attrib['d'])
+    out = []
+    i = 0
+    while i < len(tokens):
+        if tokens[i].isalpha(): out.append(tokens[i]); i += 1
+        else:
+            x, y = map(float, tokens[i:i+2]); i += 2
+            out.append(f'{(a*x+c*y+e-3946.359)*108/1283.436:.5f},{(b*x+d*y+f-3001.249)*108/1283.436:.5f}')
+    paths.append(' '.join(out))
+for name, mono in [('app_icon_foreground', False), ('app_icon_foreground_monochrome', True), ('ic_jellyfin', True)]:
+    v = vector(108, 108, 108, 108)
+    for i, data in enumerate(paths):
+        p = ET.SubElement(v, 'path', attrs(pathData=data))
+        if mono or i: p.set(f'{{{ANDROID}}}fillColor', '#FFFFFF')
+        else: gradient(p, 20, 20, 90, 90)
+    save(f'drawable/{name}.xml', v)
+
+# Launcher PNGs and TV banners rendered directly from the supplied vectors.
+logo_body = ET.tostring(logo, encoding='unicode')
+icon_body = ET.tostring(icon, encoding='unicode')
+def render(svg, width, height, path):
+    subprocess.run(['rsvg-convert', '-w', str(width), '-h', str(height), '-o', str(path)], input=svg.encode(), check=True)
+banner = f'<svg xmlns="http://www.w3.org/2000/svg" width="320" height="180" viewBox="0 0 320 180"><rect width="320" height="180" fill="#080c14"/><svg x="24" y="67" width="272" height="46">{logo_body}</svg></svg>'
+launcher = f'<svg xmlns="http://www.w3.org/2000/svg" width="108" height="108" viewBox="0 0 108 108"><rect width="108" height="108" fill="#080c14"/>{icon_body}</svg>'
+for density, scale in [('mdpi',1),('hdpi',1.5),('xhdpi',2),('xxhdpi',3),('xxxhdpi',4)]:
+    render(banner, int(160*scale), int(90*scale), RES/f'mipmap-{density}/app_banner.png')
+    render(launcher, int(48*scale), int(48*scale), RES/f'mipmap-{density}/app_icon.png')
+# Keep drawable banner in sync with launchers.
+(RES/'drawable-nodpi').mkdir(exist_ok=True)
+render(banner, 640, 360, RES/'drawable-nodpi/absorflix_banner.png')
+(RES/'drawable/app_banner_foreground.xml').write_text('<bitmap xmlns:android="http://schemas.android.com/apk/res/android" android:src="@drawable/absorflix_banner" android:gravity="fill" />\n')
+for name in ['app_icon_background', 'app_banner_background']:
+    path = RES/f'drawable/{name}.xml'
+    path.write_text(path.read_text().replace('#000B25', '#080C14'))
+print('Absorflix logo, adaptive icons and TV banners exported.')
diff --git a/branding/install-nas.sh b/branding/install-nas.sh
new file mode 100755
index 0000000..2592c3b
--- /dev/null
+++ b/branding/install-nas.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -euo pipefail
+# Run from the extracted package on NAS1. Requires the persistent Absorflix web deployment.
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
+sha256sum -c SHA256SUMS >/dev/null
+web_root="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/usr/share/jellyfin/web"}}{{.Source}}{{end}}{{end}}' jellyfin)"
+if [[ -z "$web_root" || ! -d "$web_root" || ! -f "$web_root/absorflix-release.json" ]]; then
+  echo 'No se encuentra el montaje persistente de Absorflix web. Despliega primero el paquete web de Absorflix.' >&2
+  exit 1
+fi
+source_dir="$PWD/web/absorflix/tv"
+target_dir="$web_root/absorflix/tv"
+mkdir -p -- "$target_dir"
+if [[ -f "$target_dir/latest.json" ]]; then
+  backup_dir="$(mktemp -d "$web_root/absorflix/tv-backup-$(date +%Y%m%d-%H%M%S)-XXXXXX")"
+  cp -p -- "$target_dir/latest.json" "$backup_dir/"
+  [[ ! -f "$target_dir/index.html" ]] || cp -p -- "$target_dir/index.html" "$backup_dir/"
+fi
+# Never replace an already published version with different bytes.
+for file in "$source_dir"/*.apk "$source_dir"/*-source.tar.gz; do
+  destination="$target_dir/$(basename -- "$file")"
+  if [[ -f "$destination" ]] && ! cmp -s -- "$file" "$destination"; then
+    echo "Ya existe una versión distinta con el mismo nombre: $destination" >&2
+    exit 1
+  fi
+done
+# Copy immutable artifacts first; publish the update pointer only after they are in place.
+for file in "$source_dir"/*; do
+  [[ "$(basename -- "$file")" != latest.json ]] || continue
+  temporary="$(mktemp "$target_dir/.upload.XXXXXX")"
+  cp -- "$file" "$temporary"
+  chmod 644 "$temporary"
+  mv -f -- "$temporary" "$target_dir/$(basename -- "$file")"
+done
+temporary="$(mktemp "$target_dir/.latest.XXXXXX")"
+cp -- "$source_dir/latest.json" "$temporary"
+chmod 644 "$temporary"
+mv -f -- "$temporary" "$target_dir/latest.json"
+echo 'Publicado. Comprueba https://player.absor.top/web/absorflix/tv/index.html'
+echo 'No se ha reiniciado Jellyfin.'
diff --git a/branding/release.py b/branding/release.py
new file mode 100755
index 0000000..39d94f5
--- /dev/null
+++ b/branding/release.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Build a signed APK and a self-contained NAS distribution with matching GPL source."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+
+ROOT = Path(__file__).resolve().parents[1]
+PRIVATE = Path.home() / 'Library/Application Support/Absorflix/signing'
+SDK = Path(os.environ.get('ANDROID_HOME', '/opt/homebrew/share/android-commandlinetools'))
+JDK = Path(os.environ.get('JAVA_HOME', '/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home'))
+VERSION = os.environ.get('ABSORFLIX_VERSION', '1.0.0-preview.2')
+CODE = int(os.environ.get('ABSORFLIX_VERSION_CODE', '2'))
+OUT = ROOT / 'branding/dist' / VERSION
+# Keep old APKs, manifests, source archives and signatures intact locally too.
+if OUT.exists() and any(OUT.iterdir()):
+    raise SystemExit(f'Release output already exists: {OUT}. Use a new version; published artifacts are immutable.')
+
+PRIVATE.mkdir(parents=True, exist_ok=True, mode=0o700)
+os.chmod(PRIVATE, 0o700)
+credentials = PRIVATE / 'signing.json'
+keystore = PRIVATE / 'absorflix-tv.jks'
+if credentials.exists():
+    secret = json.loads(credentials.read_text())['password']
+    if not keystore.is_file():
+        raise SystemExit('Signing keystore is missing. Restore it from backup; do not replace the app identity.')
+else:
+    if keystore.exists():
+        raise SystemExit('Signing credentials are missing. Restore them instead of replacing the keystore.')
+    import secrets
+    secret = secrets.token_urlsafe(48)
+    with open(credentials, 'x', opener=lambda path, flags: os.open(path, flags, 0o600)) as f:
+        json.dump({'password': secret, 'alias': 'absorflix-tv'}, f)
+    env = dict(os.environ, ABSORFLIX_STORE_PASSWORD=secret)
+    subprocess.run([str(JDK/'bin/keytool'), '-genkeypair', '-keystore', str(keystore), '-alias', 'absorflix-tv',
+                    '-keyalg', 'RSA', '-keysize', '4096', '-validity', '10000', '-dname', 'CN=Absorflix TV',
+                    '-storepass:env', 'ABSORFLIX_STORE_PASSWORD', '-keypass:env', 'ABSORFLIX_STORE_PASSWORD'],
+                   env=env, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    os.chmod(keystore, 0o600)
+
+env = dict(os.environ, JAVA_HOME=str(JDK), ANDROID_HOME=str(SDK), KEYSTORE_FILE=str(keystore),
+           KEYSTORE_PASSWORD=secret, SIGNING_KEY_ALIAS='absorflix-tv', SIGNING_KEY_PASSWORD=secret)
+subprocess.run(['./gradlew', ':app:assembleRelease', f'-Pabsorflix.version={VERSION}', f'-Pabsorflix.versionCode={CODE}', '--console=plain'], cwd=ROOT, env=env, check=True)
+apk = ROOT / f'app/build/outputs/apk/release/absorflix-tv-{VERSION}-release.apk'
+public = OUT / 'web/absorflix/tv'
+public.mkdir(parents=True, exist_ok=True)
+apk_name = f'absorflix-tv-{VERSION}.apk'
+shutil.copy2(apk, public/apk_name)
+verify = subprocess.run([str(SDK/'build-tools/36.0.0/apksigner'), 'verify', '--verbose', '--print-certs', str(public/apk_name)], env=env, check=True, text=True, capture_output=True)
+(OUT/'signature.txt').write_text(verify.stdout)
+manifest = {'versionCode': CODE, 'versionName': VERSION, 'url': f'https://player.absor.top/web/absorflix/tv/{apk_name}',
+            'sha256': hashlib.sha256(apk.read_bytes()).hexdigest(), 'size': apk.stat().st_size}
+(public/'latest.json').write_text(json.dumps(manifest, indent=2)+'\n')
+# Include precisely the corresponding source, build scripts, license and custom assets, never private signing data.
+paths = subprocess.check_output(['git', 'ls-files', '-c', '-o', '--exclude-standard', '-z'], cwd=ROOT).decode().split('\0')
+source_name = f'absorflix-tv-{VERSION}-source.tar.gz'
+with tarfile.open(public/source_name, 'w:gz') as archive:
+    for name in sorted(set(filter(None, paths))):
+        path = ROOT/name
+        if path.is_file(): archive.add(path, arcname=f'absorflix-tv-{VERSION}/{name}', recursive=False)
+shutil.copy2(ROOT/'branding/assets/logo.svg', public/'logo.svg')
+shutil.copy2(ROOT/'LICENSE', public/'LICENSE.txt')
+html = (ROOT/'branding/download.html').read_text().replace('{{VERSION}}', VERSION).replace('{{APK}}', apk_name).replace('{{SOURCE}}', source_name)
+(public/'index.html').write_text(html)
+shutil.copy2(ROOT/'branding/install-nas.sh', OUT/'install-nas.sh')
+checksums = []
+for path in sorted(public.iterdir()):
+    checksums.append(f'{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(OUT)}')
+(OUT/'SHA256SUMS').write_text('\n'.join(checksums)+'\n')
+package = OUT/f'absorflix-tv-{VERSION}-nas.tar.gz'
+with tarfile.open(package, 'w:gz') as archive:
+    for name in ['web', 'install-nas.sh', 'SHA256SUMS', 'signature.txt']:
+        archive.add(OUT/name, arcname=name)
+print(f'\nSigned APK: {public/apk_name}\nNAS package: {package}\nAPK SHA256: {manifest["sha256"]}\nSigning identity stored privately at: {PRIVATE}')
