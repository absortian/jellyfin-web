+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="login_help_description">Absorflix conecta automáticamente con player.absor.top. Inicia sesión con tu cuenta o utiliza Conexión rápida desde el móvil.</string>
+    <string name="login_quickconnect_step_1">1. Abre https://player.absor.top en el móvil e inicia sesión.</string>
+    <string name="absorflix_intro_skip">OK: Omitir intro  ·  Atrás: Cancelar</string>
+    <string name="absorflix_updates_title">Actualizaciones de Absorflix</string>
+    <string name="absorflix_updates_check">Buscar actualizaciones</string>
+    <string name="absorflix_updates_checking">Buscando actualizaciones…</string>
+    <string name="absorflix_updates_current">Tienes la última versión disponible.</string>
+    <string name="absorflix_updates_failed">No se han podido comprobar las actualizaciones. Inténtalo más tarde.</string>
+    <string name="absorflix_updates_install">Instalar actualización</string>
+    <string name="absorflix_updates_available">Está disponible la versión %1$s.</string>
+    <string name="absorflix_updates_download">Descargando actualización…</string>
+    <string name="absorflix_updates_invalid">No se ha podido verificar la actualización.</string>
+    <string name="absorflix_updates_permission">Permite que Absorflix instale sus actualizaciones y vuelve aquí.</string>
+    <string name="absorflix_updates_cancel">Cancelar</string>
+</resources>
diff --git a/app/src/main/res/values/absorflix.xml b/app/src/main/res/values/absorflix.xml
new file mode 100644
index 0000000..869166a
--- /dev/null
+++ b/app/src/main/res/values/absorflix.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Absorflix-specific copy is maintained in English and Spanish; other locales use English. -->
+<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
+    <string name="login_help_description">Absorflix connects to player.absor.top automatically. Sign in with your account, or use Quick Connect from your phone.</string>
+    <string name="login_quickconnect_step_1">1. Open https://player.absor.top on your phone and sign in.</string>
+    <string name="absorflix_intro_skip">OK: Skip intro  ·  Back: Cancel</string>
+    <string name="absorflix_updates_title">Absorflix updates</string>
+    <string name="absorflix_updates_check">Check for updates</string>
+    <string name="absorflix_updates_checking">Checking for updates…</string>
+    <string name="absorflix_updates_current">You have the latest available version.</string>
+    <string name="absorflix_updates_failed">Could not check for updates. Please try again later.</string>
+    <string name="absorflix_updates_install">Install update</string>
+    <string name="absorflix_updates_available">Version %1$s is available.</string>
+    <string name="absorflix_updates_download">Downloading update…</string>
+    <string name="absorflix_updates_invalid">The update could not be verified.</string>
+    <string name="absorflix_updates_permission">Allow Absorflix to install its updates, then return here.</string>
+    <string name="absorflix_updates_cancel">Cancel</string>
+</resources>
