+++ b/app/src/main/java/org/jellyfin/androidtv/branding/BrandIntro.kt
@@ -0,0 +1,223 @@
+package org.jellyfin.androidtv.branding
+
+import android.app.Dialog
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Shader
+import android.media.AudioAttributes
+import android.media.MediaPlayer
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.provider.Settings
+import android.view.KeyEvent
+import android.view.View
+import android.view.Window
+import android.view.WindowManager
+import android.view.animation.PathInterpolator
+import androidx.core.graphics.PathParser
+import android.graphics.Path
+import org.xmlpull.v1.XmlPullParser
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleOwner
+import org.jellyfin.androidtv.R
+import org.jellyfin.sdk.model.api.BaseItemDto
+import org.jellyfin.sdk.model.api.BaseItemKind
+import org.jellyfin.sdk.model.api.LocationType
+import org.jellyfin.sdk.model.api.MediaType
+import kotlin.math.sin
+
+/** Local native intro. Playback starts only after completion/skip, never after cancellation. */
+class BrandIntro(
+	private val context: Context,
+	private val owner: LifecycleOwner,
+	private val onComplete: Runnable,
+	private val onBack: Runnable,
+) : DefaultLifecycleObserver {
+	private val handler = Handler(Looper.getMainLooper())
+	private var dialog: Dialog? = null
+	private var player: MediaPlayer? = null
+	private var finished = false
+	private var started = false
+	private val timeout = Runnable { complete() }
+
+	companion object {
+		@JvmStatic
+		fun shouldShow(item: BaseItemDto?): Boolean = item != null &&
+			item.mediaType == MediaType.VIDEO && item.locationType != LocationType.VIRTUAL &&
+			item.type !in setOf(BaseItemKind.TV_CHANNEL, BaseItemKind.PROGRAM, BaseItemKind.TRAILER)
+	}
+
+	fun start() {
+		if (finished || owner.lifecycle.currentState == Lifecycle.State.DESTROYED) return
+		owner.lifecycle.addObserver(this)
+		if (owner.lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)) show()
+	}
+
+	override fun onStart(owner: LifecycleOwner) = show()
+	override fun onStop(owner: LifecycleOwner) = cancel()
+	override fun onDestroy(owner: LifecycleOwner) = cancel()
+
+	private fun show() {
+		if (started || finished) return
+		started = true
+		val view = IntroView(context)
+		dialog = Dialog(context, android.R.style.Theme_Black_NoTitleBar_Fullscreen).apply {
+			requestWindowFeature(Window.FEATURE_NO_TITLE)
+			setContentView(view)
+			setCancelable(false)
+			setOnKeyListener { _, key, event ->
+				when (key) {
+					KeyEvent.KEYCODE_BACK -> {
+						if (event.action == KeyEvent.ACTION_UP) { cancel(); onBack.run() }
+						true
+					}
+					KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE -> {
+						if (event.action == KeyEvent.ACTION_UP) complete()
+						true
+					}
+					else -> false
+				}
+			}
+			show()
+			window?.setLayout(WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT)
+			window?.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+		}
+		view.setOnClickListener { complete() }
+		// Always bounded, even when the audio device cannot initialize.
+		handler.postDelayed(timeout, 5500)
+		try {
+			val audio = MediaPlayer()
+			player = audio
+			audio.setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_MEDIA).setContentType(AudioAttributes.CONTENT_TYPE_MOVIE).build())
+			context.resources.openRawResourceFd(R.raw.absorflix_intro).use {
+				audio.setDataSource(it.fileDescriptor, it.startOffset, it.length)
+			}
+			audio.setOnPreparedListener {
+				if (!finished) {
+					view.restart()
+					it.start()
+				}
+			}
+			audio.setOnCompletionListener { complete() }
+			audio.setOnErrorListener { _, _, _ -> complete(); true }
+			audio.prepareAsync()
+		} catch (_: Exception) {
+			// Playback remains usable if intro audio fails.
+			complete()
+		}
+	}
+
+	private fun complete() {
+		if (finished) return
+		cancel()
+		onComplete.run()
+	}
+
+	/** Dispose without launching the movie; safe to call repeatedly. */
+	fun cancel() {
+		if (finished) return
+		finished = true
+		handler.removeCallbacks(timeout)
+		owner.lifecycle.removeObserver(this)
+		player?.release()
+		player = null
+		dialog?.dismiss()
+		dialog = null
+	}
+}
+
+/** Original Absorflix wordmark, zoom through its A, then vertical light streaks. */
+private class IntroView(context: Context) : View(context) {
+	// Draw vector paths directly: VectorDrawable bitmap caching blurs at the 22× zoom.
+	private val logoPaths = mutableListOf<Pair<Path, Paint>>().apply {
+		context.resources.getXml(R.xml.absorflix_logo).use { xml ->
+			while (xml.eventType != XmlPullParser.END_DOCUMENT) {
+				if (xml.eventType == XmlPullParser.START_TAG && xml.name == "path") {
+					val data = xml.getAttributeValue("http://schemas.android.com/apk/res/android", "pathData")
+					val colorPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+					val endpoints = when (size) {
+						0 -> floatArrayOf(40.63f, 77.13f, 184.43f, 220.94f)
+						5 -> floatArrayOf(575.54f, 75.17f, 597.35f, 96.99f)
+						6 -> floatArrayOf(867f, 14.8f, 1269.5f, 201f)
+						else -> null
+					}
+					if (endpoints != null) colorPaint.shader = LinearGradient(endpoints[0], endpoints[1], endpoints[2], endpoints[3],
+						0xFF00C9FF.toInt(), Color.BLUE, Shader.TileMode.CLAMP)
+					add(requireNotNull(PathParser.createPathFromPathData(data)) to colorPaint)
+				}
+				xml.next()
+			}
+		}
+	}
+	private val zoomEasing = PathInterpolator(.9f, .01f, 1f, 1f)
+	private val lightsEasing = PathInterpolator(.32f, 0f, .65f, 1f)
+	// Construct shaders once in normalized coordinates, then move/scale them with
+	// the canvas. Rebuilding 52 gradients and color arrays on every frame causes GC.
+	private class LightStreak(val offset: Float, val halfWidth: Float, val brightness: Float, val paint: Paint)
+	private val lights = Array(52) { i ->
+		val colors = intArrayOf(0xFF004CFF.toInt(), 0xFF00C9FF.toInt(), 0xFF6AE5FF.toInt(), 0xFF0A84FF.toInt(), 0xFF713CFF.toInt())
+		LightStreak((i % 26 - 12.5f) / 22f, .001f + (i % 5) * .001f, .55f + .45f * sin(i * 7f),
+			Paint(Paint.ANTI_ALIAS_FLAG).apply {
+				shader = LinearGradient(-1f, 0f, 1f, 0f,
+					intArrayOf(Color.TRANSPARENT, colors[i % colors.size], Color.TRANSPARENT), null, Shader.TileMode.CLAMP)
+			})
+	}
+	private val skipLabel = context.getString(R.string.absorflix_intro_skip)
+	private val skipPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.LTGRAY; alpha = 200; textAlign = Paint.Align.RIGHT }
+	private var startTime = 0L
+	private val reduceMotion = Settings.Global.getFloat(context.contentResolver, Settings.Global.ANIMATOR_DURATION_SCALE, 1f) == 0f
+
+	fun restart() { startTime = SystemClock.uptimeMillis(); invalidate() }
+
+	override fun onDraw(canvas: Canvas) {
+		super.onDraw(canvas)
+		canvas.drawColor(Color.BLACK)
+		val t = if (startTime == 0L) 0f else ((SystemClock.uptimeMillis() - startTime) / 4063f).coerceIn(0f, 1f)
+		val logoWidth = width * .62f
+		val logoHeight = logoWidth * 218.27f / 1296f
+		val left = (width - logoWidth) / 2
+		val top = (height - logoHeight) / 2
+		canvas.save()
+		if (!reduceMotion) {
+			// Same continuous drift, accelerating zoom and overlapping fades as the web.
+			// Opacity landmarks never restart or pause the movement.
+			val eased = zoomEasing.getInterpolation(((t - .36f) / .48f).coerceIn(0f, 1f))
+			val scale = if (t < .36f) .86f + .18f * t / .36f else 1.04f + 20.96f * eased
+			canvas.translate((width * .5f - (left + logoWidth * .087f)) * eased, 0f)
+			canvas.scale(scale, scale, left + logoWidth * .087f, height / 2f)
+		}
+		canvas.translate(left, top)
+		canvas.scale(logoWidth / 1296f, logoHeight / 218.27f)
+		val logoAlpha = if (reduceMotion) 255 else
+			(255 * (t / .14f).coerceIn(0f, 1f) * ((.82f - t) / .26f).coerceIn(0f, 1f)).toInt()
+		logoPaths.forEach { (path, logoPaint) ->
+			logoPaint.alpha = logoAlpha
+			canvas.drawPath(path, logoPaint)
+		}
+		canvas.restore()
+		if (!reduceMotion && t > .44f) {
+			val opacity = ((t - .44f) / .19f).coerceIn(0f, 1f) * ((1f - t) / .20f).coerceIn(0f, 1f)
+			val expansion = .018f + 1.782f * lightsEasing.getInterpolation(((t - .38f) / .62f).coerceIn(0f, 1f))
+			for (i in lights.indices) {
+				val light = lights[i]
+				val drift = if (i < 26) 0f else -.08f + .16f * t
+				val center = width / 2f + width * expansion * (light.offset + drift)
+				val half = width * expansion * light.halfWidth
+				light.paint.alpha = (255 * opacity * light.brightness).toInt().coerceIn(0, 255)
+				canvas.save()
+				canvas.translate(center, 0f)
+				canvas.scale(half, height.toFloat())
+				canvas.drawRect(-1f, 0f, 1f, 1f, light.paint)
+				canvas.restore()
+			}
+		}
+		skipPaint.textSize = height * .025f
+		canvas.drawText(skipLabel, width * .95f, height * .93f, skipPaint)
+		if (!reduceMotion && startTime != 0L && isAttachedToWindow && t < 1f) postInvalidateOnAnimation()
+	}
+}
