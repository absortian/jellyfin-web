@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Exercise publication in a fake NAS web mount; never talks to Docker or the NAS."""
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+class InstallTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.web = self.root/'mounted-web'
+        self.web.mkdir()
+        (self.web/'absorflix-release.json').write_text('{}')
+        (self.web/'index.html').write_text('existing web untouched')
+        self.package = self.root/'package'
+        self.source = self.package/'web/absorflix/tv'
+        self.source.mkdir(parents=True)
+        shutil.copy2(Path(__file__).with_name('install-nas.sh'), self.package/'install-nas.sh')
+        for name, content in {'v1.apk':'APK', 'v1-source.tar.gz':'source', 'latest.json':'manifest 1', 'index.html':'download page'}.items():
+            (self.source/name).write_text(content)
+        self.hashes()
+        binary = self.root/'bin'; binary.mkdir()
+        docker = binary/'docker'; docker.write_text('#!/bin/sh\nprintf "%s\\n" "$ABSORFLIX_TEST_WEB"\n'); docker.chmod(0o755)
+        self.env = dict(os.environ, PATH=f'{binary}:{os.environ["PATH"]}', ABSORFLIX_TEST_WEB=str(self.web))
+    def tearDown(self): self.tmp.cleanup()
+    def hashes(self):
+        (self.package/'SHA256SUMS').write_text(''.join(f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.relative_to(self.package)}\n' for p in sorted(self.source.iterdir())))
+    def run_install(self):
+        return subprocess.run(['bash',str(self.package/'install-nas.sh')],env=self.env,capture_output=True,text=True)
+    def test_publish_and_repeat_preserve_the_web_and_keep_backup(self):
+        self.assertEqual(self.run_install().returncode,0)
+        self.assertEqual((self.web/'absorflix/tv/latest.json').read_text(),'manifest 1')
+        self.assertEqual((self.web/'index.html').read_text(),'existing web untouched')
+        self.assertEqual(self.run_install().returncode,0)
+        self.assertEqual(len(list((self.web/'absorflix').glob('tv-backup-*'))),1)
+    def test_corrupt_download_is_rejected_before_mutating_web(self):
+        (self.source/'v1.apk').write_text('tampered')
+        self.assertNotEqual(self.run_install().returncode,0)
+        self.assertFalse((self.web/'absorflix').exists())
+    def test_missing_persistent_brand_mount_is_rejected(self):
+        (self.web/'absorflix-release.json').unlink()
+        self.assertNotEqual(self.run_install().returncode,0)
+        self.assertFalse((self.web/'absorflix').exists())
+    def test_same_version_cannot_be_replaced_with_different_bytes(self):
+        self.assertEqual(self.run_install().returncode,0)
+        (self.source/'v1.apk').write_text('different release')
+        (self.source/'latest.json').write_text('manifest tampered')
+        self.hashes()
+        self.assertNotEqual(self.run_install().returncode,0)
+        self.assertEqual((self.web/'absorflix/tv/v1.apk').read_text(),'APK')
+        self.assertEqual((self.web/'absorflix/tv/latest.json').read_text(),'manifest 1')
+
+if __name__=='__main__': unittest.main()
