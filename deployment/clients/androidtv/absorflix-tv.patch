new file mode 100644
index 0000000..4a89abd
--- /dev/null
+++ b/app/src/test/kotlin/branding/BrandingTests.kt
@@ -0,0 +1,45 @@
+package org.jellyfin.androidtv.branding
+
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import org.jellyfin.sdk.model.api.BaseItemDto
+import org.jellyfin.sdk.model.api.BaseItemKind
+import org.jellyfin.sdk.model.api.LocationType
+import org.jellyfin.sdk.model.api.MediaType
+import java.util.UUID
+
+class BrandingTests : FunSpec({
+	val movie = BaseItemDto(id = UUID.randomUUID(), mediaType = MediaType.VIDEO, type = BaseItemKind.MOVIE)
+	test("movies and each episode are eligible for the native intro") {
+		BrandIntro.shouldShow(movie) shouldBe true
+		BrandIntro.shouldShow(movie.copy(type = BaseItemKind.EPISODE)) shouldBe true
+	}
+	test("live TV, programs, trailers, missing videos and audio never get the intro") {
+		listOf(BaseItemKind.TV_CHANNEL, BaseItemKind.PROGRAM, BaseItemKind.TRAILER).forEach {
+			BrandIntro.shouldShow(movie.copy(type = it)) shouldBe false
+		}
+		BrandIntro.shouldShow(movie.copy(locationType = LocationType.VIRTUAL)) shouldBe false
+		BrandIntro.shouldShow(movie.copy(mediaType = MediaType.AUDIO)) shouldBe false
+		BrandIntro.shouldShow(null) shouldBe false
+	}
+	val release = AbsorflixUpdate(2, "1.0.0", "https://player.absor.top/web/absorflix/tv/absorflix-tv.apk", "a".repeat(64), 1024)
+	test("valid HTTPS update in the release directory is accepted") { release.validate() }
+	test("updates cannot redirect downloads to another origin or include credentials") {
+		listOf("http://player.absor.top/web/absorflix/tv/a.apk", "https://evil.example/web/absorflix/tv/a.apk",
+			"https://player.absor.top.evil.example/web/absorflix/tv/a.apk", "https://user@player.absor.top/web/absorflix/tv/a.apk",
+			"https://player.absor.top:8096/web/absorflix/tv/a.apk").forEach { url ->
+			(runCatching { release.copy(url = url).validate() }.exceptionOrNull() is IllegalArgumentException) shouldBe true
+		}
+	}
+	test("encoded and literal path traversal, queries, fragments and wrong extensions are rejected") {
+		listOf("../a.apk", "%2e%2e/a.apk", "a.apk?redirect=1", "a.apk#fragment", "a.zip").forEach { suffix ->
+			(runCatching { release.copy(url = "https://player.absor.top/web/absorflix/tv/$suffix").validate() }.exceptionOrNull() is IllegalArgumentException) shouldBe true
+		}
+	}
+	test("update metadata requires bounded size, a SHA256 digest and a positive version") {
+		listOf(release.copy(size = 0), release.copy(size = AbsorflixUpdate.MAX_APK_BYTES + 1), release.copy(sha256 = "bad"),
+			release.copy(versionCode = 0), release.copy(versionName = "")).forEach {
+			(runCatching { it.validate() }.exceptionOrNull() is IllegalArgumentException) shouldBe true
+		}
+	}
+})
